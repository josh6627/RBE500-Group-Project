        <box size="0.08 0.08 1.0"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 1.0"/>
      </geometry>
    </collision>

    <!-- horizontal part -->
