<?xml version="1.0"?>
<robot name="arm">
  <!--
    Launching Gazebo:
        ros2 launch ros_gz_sim gz_sim.launch.py gz_args:=empty.sdf

    Spawning robot:
        ros2 launch ros_gz_sim gz_spawn_model.launch.py \
          world:=empty \
          file:=$HOME/Robotics/rbe500/group-project/src/scara_params/urdf/scara.urdf \
          entity_name:=arm \
          x:=0.0 y:=0.0 z:=0.0
  -->

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>

  <material name="blue">
    <color rgba="0.1 0.3 0.9 1"/>
  </material>

  <material name="dark_gray">
    <color rgba="0.25 0.25 0.25 1"/>
  </material>

  <!-- Anchor the robot to the Gazebo world -->
  <link name="world"/>

  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Robot base -->
  <link name="base">
    <visual name="base_visual">
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision name="base_collision">
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.0417"
        ixy="0"
        ixz="0"
        iyy="0.0417"
        iyz="0"
        izz="0.075"/>
    </inertial>
  </link>

  <!-- Joint 1 remains fixed for the current assignment -->
  <joint name="joint_1" type="fixed">
    <parent link="base"/>
    <child link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- L-shaped link 1 -->
  <link name="link_1">
    <!-- Vertical section -->
    <visual name="link_1_vertical_visual">
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 1.0"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision name="link_1_vertical_collision">
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 1.0"/>
      </geometry>
    </collision>

    <!-- Horizontal section -->
    <visual name="link_1_horizontal_visual">
      <origin xyz="0.5 0 1.0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.08 0.08"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision name="link_1_horizontal_collision">
      <origin xyz="0.5 0 1.0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.08 0.08"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.25 0 0.75" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.1"
        ixy="0"
        ixz="0"
        iyy="0.1"
        iyz="0"
        izz="0.1"/>
    </inertial>
  </link>

  <!-- Joint 2 remains fixed for the current assignment -->
  <joint name="joint_2" type="fixed">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="1.0 0 1.0" rpy="0 0 0"/>
  </joint>

  <!-- Link 2 -->
  <link name="link_2">
    <!-- Joint hub at joint_2 -->
    <visual name="joint_2_hub_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision name="joint_2_hub_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>

    <!-- Horizontal arm -->
    <visual name="link_2_arm_visual">
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.08 0.08"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision name="link_2_arm_collision">
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.0 0.08 0.08"/>
      </geometry>
    </collision>

    <!--
      Fixed outer housing of the prismatic joint (for visual effect)
    -->
    <visual name="prismatic_housing_visual">
      <origin xyz="1.0 0 -0.19" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.30"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <inertial>
      <origin xyz="0.5 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.1"
        iyz="0"
        izz="0.1"/>
    </inertial>
  </link>

  <!--
    Joint 3: vertical prismatic joint.
  -->
  <joint name="joint_3" type="prismatic">
    <parent link="link_2"/>
    <child link="tool_link"/>

    <!-- End of link_2 and underside of the arm -->
    <origin xyz="1.0 0 -0.04" rpy="0 0 0"/>

    <!-- Positive joint displacement moves downward -->
    <axis xyz="0 0 -1"/>

    <limit
      lower="0.0"
      upper="0.5"
      effort="20"
      velocity="0.25"/>

    <dynamics damping="1.0" friction="0.0"/>
  </joint>

  <!-- Moving inner rod and end-effector plate -->
  <link name="tool_link">
    <visual name="slider_rod_visual">
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.40"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision name="slider_rod_collision">
      <origin xyz="0 0 -0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.40"/>
      </geometry>
    </collision>

    <!-- Tool plate attached to the bottom of the rod -->
    <visual name="tool_plate_visual">
      <origin xyz="0 0 -0.425" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.16 0.05"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision name="tool_plate_collision">
      <origin xyz="0 0 -0.425" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.16 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 -0.22" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.008"
        ixy="0"
        ixz="0"
        iyy="0.008"
        iyz="0"
        izz="0.001"/>
    </inertial>
  </link>

  <!-- Publish joint states from Gazebo -->
  <gazebo>
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">

      <topic>/joint_states</topic>
      <joint_name>joint_3</joint_name>
    </plugin>
  </gazebo>

  <!-- Apply force commands to joint_3 -->
  <gazebo>
    <plugin
      filename="gz-sim-apply-joint-force-system"
      name="gz::sim::systems::ApplyJointForce">

      <joint_name>joint_3</joint_name>
    </plugin>
  </gazebo>
</robot>


